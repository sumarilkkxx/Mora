{
  "name": "mora",
  "version": "0.2.0",
  "description": "MORA — Multimodal Orchestration for Retail Automation",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "xixihhhh",
  "main": "electron/main.js",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck:js": "tsc -p tsconfig.node-scripts.json",
    "eval:agent:smoke": "tsx tools/agent-eval/run-fixed.ts --dataset=smoke",
    "eval:agent:report": "tsx tools/agent-eval/report.ts",
    "eval:agent:devtool": "tsx tools/agent-eval/server.ts",
    "eval:agent:test": "vitest run --config tools/agent-eval/vitest.config.ts",
    "cli": "node bin/mora.mjs",
    "render:element": "node scripts/render-element.mjs",
    "media:prepare": "node scripts/prepare-media-binaries.mjs",
    "bundle:standalone": "node scripts/bundle-standalone.mjs",
    "bundle:desktop": "next build && pnpm bundle:standalone",
    "electron": "electron .",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3",
    "pack:dir": "pnpm media:prepare && pnpm bundle:desktop && electron-builder --dir",
    "dist": "pnpm media:prepare && pnpm bundle:desktop && electron-builder --publish never",
    "dist:win": "pnpm media:prepare && pnpm bundle:desktop && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "pnpm media:prepare && pnpm bundle:desktop && electron-builder --mac dmg --publish never",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:run": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@huggingface/transformers": "4.2.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "geist": "^1.7.2",
    "lucide": "0.577.0",
    "lucide-react": "^0.577.0",
    "morphicons": "1.7.1",
    "motion": "^12.38.0",
    "next": "16.2.11",
    "openai": "^6.32.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "undici": "6.27.0",
    "zustand": "^5.0.12"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "adm-zip": "0.6.0",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "sharp": "0.35.0",
      "onnxruntime-node": "1.23.2"
    },
    "onlyBuiltDependencies": [
      "@ffprobe-installer/ffprobe",
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild",
      "ffmpeg-static",
      "msw",
      "onnxruntime-node",
      "protobufjs"
    ]
  },
  "build": {
    "appId": "com.mora.app",
    "productName": "Mora",
    "buildVersion": "0.2.0.0",
    "npmRebuild": false,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "afterPack": "./electron/after-pack.cjs",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "identity": null,
      "hardenedRuntime": false,
      "bundleShortVersion": "0.2.0",
      "bundleVersion": "0.2.0",
      "artifactName": "${productName}-v${version}.0-mac-${arch}.${ext}",
      "icon": "electron/icon.png"
    },
    "dmg": {
      "format": "UDBZ"
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-v${version}.0-win-${arch}.${ext}",
      "icon": "electron/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron/icon.png"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
